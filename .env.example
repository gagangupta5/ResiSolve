# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/resisolve

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# SMTP / Email Configuration (For simulated emails, leave these blank)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM_NAME=ResiSolve System
SMTP_FROM_EMAIL=noreply@resisolve.com
